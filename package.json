{
  "name": "opencode-mytoken",
  "version": "0.1.0",
  "description": "Check Sekai Gateway usage with /mytoken in OpenCode v2.",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.12"
  },
  "devDependencies": {
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.18",
    "typescript": "~5.9.3"
  }
}
